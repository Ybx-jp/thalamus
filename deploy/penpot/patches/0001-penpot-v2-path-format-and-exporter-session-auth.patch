+# Penpot's path format dispatches on these names — `app.common.types.path.impl/
+# from-plain` has a clause for each and throws `No matching clause` on anything
+# else. SVG's single letters are accepted here as a convenience and translated;
+# the long forms are what goes on the wire, and are what
+# `transformers/svg.py::_path_content_to_d` reads back.
+PATH_COMMANDS = {
+    "M": "move-to",
+    "L": "line-to",
+    "C": "curve-to",
+    "Z": "close-path",
+    "MOVE-TO": "move-to",
+    "LINE-TO": "line-to",
+    "CURVE-TO": "curve-to",
+    "CLOSE-PATH": "close-path",
+}
+
+
+def _cubic_bounds(p0: float, p1: float, p2: float, p3: float) -> tuple[float, float]:
+    """Exact min/max of one axis of a cubic Bezier, interior extrema included.
+
+    The anchors alone under-report a curve that bulges outside them, and the
+    selrect is what the exporter screenshots, so an under-sized box clips the
+    render.
+    """
+    lo, hi = min(p0, p3), max(p0, p3)
+
+    # B'(t) = 0 reduces to a·t² + b·t + c = 0 with these coefficients.
+    d1, d2, d3 = p1 - p0, p2 - p1, p3 - p2
+    a = d1 - 2 * d2 + d3
+    b = 2 * (d2 - d1)
+    c = d1
+
+    roots: list[float] = []
+    if abs(a) < 1e-12:
+        if abs(b) > 1e-12:
+            roots.append(-c / b)
+    else:
+        disc = b * b - 4 * a * c
+        if disc >= 0:
+            sq = disc**0.5
+            roots.extend(((-b + sq) / (2 * a), (-b - sq) / (2 * a)))
+
+    for t in roots:
+        if 0 < t < 1:
+            s = 1 - t
+            v = s * s * s * p0 + 3 * s * s * t * p1 + 3 * s * t * t * p2 + t * t * t * p3
+            lo, hi = min(lo, v), max(hi, v)
+    return lo, hi
+
 
