+LOCAL_FONT_ID = "sourcesanspro"
+
+
+def derive_font_id(font_family: str) -> str:
+    """Penpot's font id for a family name.
+
+    Penpot's renderer keys font loading off `font-id`, not `font-family` — a text
+    node carrying only a family renders in the default and looks like a font that
+    failed to load. The catalogue ids are `gfont-` + the family lowercased with
+    spaces hyphenated ("Work Sans" -> "gfont-work-sans"), validated against 1719 of
+    the 1958 catalogue entries in the shipped frontend bundle with zero mismatches.
+
+    `sourcesanspro` is the built-in default and is NOT a `gfont-` id.
+
+    This derives a well-formed id; it cannot confirm the family exists, because the
+    catalogue lives in the frontend bundle and no backend or DB surface carries it.
+    An id for a family Penpot does not have renders the default silently, so confirm
+    with `export_frame_svg` and read `font-family` off the text element rather than
+    eyeballing a PNG.
+    """
+    if font_family == LOCAL_FONT_ID:
+        return LOCAL_FONT_ID
+    return "gfont-" + font_family.lower().replace(" ", "-")
+
