# Copy to .env, fill in, then `chmod 600 .env`. .env is gitignored — this file is
# the tracked template and must never carry a real secret.

# Tailscale auth key for the stack's own node (admin console → Settings → Keys).
# Non-ephemeral: the node keeps its identity, and therefore its hostname, across
# restarts.
TS_AUTHKEY=tskey-auth-REPLACE-ME

# Must match the hostname the sidecar registers (`TS_HOSTNAME: penpot` in
# compose.yml) and your tailnet's MagicDNS suffix. Penpot builds absolute URLs
# from this, so a mismatch here is the failure that looks like a broken asset
# pipeline.
PENPOT_PUBLIC_URI=https://penpot.<your-tailnet>.ts.net

# Generated inside Penpot once your account exists: avatar → Access Tokens →
# "Generate new token". The MCP server needs it to write; without it the server
# still starts and every create/modify call fails unauthenticated.
PENPOT_ACCESS_TOKEN=

# Rendering credentials, and rendering is the only thing they do. Penpot's
# exporter authenticates by an `auth-token` session cookie and by nothing else,
# and only login-with-password (or SSO/LDAP) mints one — an access token cannot
# be exchanged for a session on any route the RPC surface exposes. Leave these
# empty and all 66 other headless tools still work; export_frame_png and
# export_frame_svg return an error that names these two variables. See README.md
# §"Why export needs a password" before deciding whose account to use.
PENPOT_EMAIL=
PENPOT_PASSWORD=

# python3 -c 'import secrets; print(secrets.token_urlsafe(48))' — one each.
PENPOT_SECRET_KEY=REPLACE-ME
PENPOT_DATABASE_PASSWORD=REPLACE-ME

# `enable-registration` is on only so the first account can be created without
# SMTP. Remove it once your account exists. `enable-access-tokens` and
# `enable-plugins-runtime` are what an MCP server needs; drop them if you never
# add one, since plugins-runtime loads third-party code into Penpot's own origin.
PENPOT_FLAGS=enable-registration enable-login-with-password enable-access-tokens enable-plugins-runtime disable-email-verification disable-onboarding
