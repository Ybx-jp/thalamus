[Unit]
# Penpot for the `designer` expert scope (docs/08). Tailnet-only via the stack's
# own tailscale sidecar, on its own MagicDNS hostname — never a subpath or an
# alternate port on the main host (see compose.yml, condition 2).
Description=Penpot — self-hosted design tool for the designer expert scope (tailnet-only, own hostname)
# The SYSTEM docker engine, not Docker Desktop's session-bound VM. A user unit is
# the right shape despite that: lingering is on, so this starts at boot without a
# login, while `--context default` keeps the containers out of the VM that holds
# the graph. A system unit would buy nothing here and cost a sudo path.
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/code/thalamus/deploy/penpot
# Pinned explicitly. A systemd unit does not inherit the login PATH, docker here
# is /usr/local/bin/docker, and this exact omission took the whole control plane
# down after an unattended reboot (`scope:homelab:claim:c4109c700854a4dc`).
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin
ExecStart=/usr/local/bin/docker --context default compose -f compose.yml up -d --remove-orphans
ExecStop=/usr/local/bin/docker --context default compose -f compose.yml stop
# No PartOf= or ordering against netns-vpn.service or transmission-daemon.service,
# deliberately: the standing rule on this box is that nothing cascades into the
# VPN namespace units (`scope:homelab:claim:dc326261c4a3c7ac`).
TimeoutStartSec=600

[Install]
WantedBy=default.target
